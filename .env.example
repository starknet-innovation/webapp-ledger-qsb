# Origin of the QSB service. Leave unset when this front end is served from the same origin.
VITE_QSB_API=
# Development only: forward /v1 to this origin (vite dev server proxy).
QSB_API_ORIGIN=
# Ledger Manager provider that lists the QSB app (given by Ledger). Unset = public catalog.
VITE_LEDGER_PROVIDER=
VITE_LEDGER_APP_NAME=PQB
# "sideload" (default: this site loads its own QSB build) or "catalog" (Ledger's servers).
VITE_LEDGER_INSTALL=
